+def loo_linear_calibration(x, y):
+    n = len(x)
+    sum_x = x.sum()
+    sum_y = y.sum()
+    sum_xy = (x * y).sum()
+    sum_x2 = (x * x).sum()
+    loo_sum_x = sum_x - x
+    loo_sum_y = sum_y - y
+    loo_sum_xy = sum_xy - x * y
+    loo_sum_x2 = sum_x2 - x * x
+    loo_n = n - 1
+    denom = loo_n * loo_sum_x2 - loo_sum_x ** 2
+    slope = (loo_n * loo_sum_xy - loo_sum_x * loo_sum_y) / denom
+    intercept = (loo_sum_y - slope * loo_sum_x) / loo_n
+    return slope * x + intercept
+
