+def vectorized_pearson(x_matrix, y_matrix):
+    x_centered = x_matrix - x_matrix.mean(axis=1, keepdims=True)
+    y_centered = y_matrix - y_matrix.mean(axis=1, keepdims=True)
+    numerator = (x_centered * y_centered).sum(axis=1)
+    denom = np.sqrt((x_centered ** 2).sum(axis=1) * (y_centered ** 2).sum(axis=1))
+    return numerator / denom
+
+
+def vectorized_spearman(x_matrix, y_matrix):
+    x_ranks = np.apply_along_axis(rankdata, 1, x_matrix)
+    y_ranks = np.apply_along_axis(rankdata, 1, y_matrix)
+    return vectorized_pearson(x_ranks, y_ranks)
+
+
+def fast_auroc(labels, scores):
+    order = np.argsort(scores, kind="mergesort")
+    sorted_labels = labels[order]
+    sorted_scores = scores[order]
+    ranks = rankdata(sorted_scores)
+    n_pos = sorted_labels.sum()
+    n_neg = len(sorted_labels) - n_pos
+    if n_pos == 0 or n_neg == 0:
+        return float("nan")
+    sum_ranks_pos = ranks[sorted_labels == 1].sum()
+    return float((sum_ranks_pos - n_pos * (n_pos + 1) / 2) / (n_pos * n_neg))
+
+
